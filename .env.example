# LM Studio: load a chat/instruct model and start its local server on port 1234.
# Enable "Serve on Local Network" so Docker can connect; allow the port through
# your firewall ONLY for trusted local/Docker networks.
# Inside Docker, localhost means the container, not the machine running LM Studio.
LLM_BASE_URL=http://host.docker.internal:1234/v1

# Use your LM Studio token when authentication is enabled.
# "lm-studio" is a harmless development value for servers without authentication.
LLM_API_KEY=lm-studio

# Optional: exact model ID from GET /v1/models. Blank selects the first model.
# Choose an instruction-following model supporting JSON response_format.
LLM_MODEL=

# The planner is single-user and has NO built-in login. Keep loopback binding
# unless protected by a trusted network or an authenticated HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=5000
